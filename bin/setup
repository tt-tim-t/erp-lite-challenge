#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  if ARGV.include?("--reset")
    puts "\n== Rebuilding the development database from scratch =="
    system! "bin/rails db:drop db:create db:schema:load db:seed"
  else
    puts "\n== Preparing the development database (creates and seeds it on first run) =="
    system! "bin/rails db:prepare"
  end

  puts "\n== Preparing the test database =="
  system! "bin/rails db:test:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\nDone. Try: bundle exec rspec"
end
